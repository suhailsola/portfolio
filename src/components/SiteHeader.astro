---
const links = [
  { href: "/", label: "Home" },
  { href: "/projects/", label: "Projects" },
  { href: "/showcase/", label: "Frontend lab" },
  { href: "/blog/", label: "Writing" },
];
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="Suhail Solah home">suhail<span>.</span></a>
  <nav aria-label="Main navigation">
    {links.map(({ href, label }) => (
      <a
        href={href}
        aria-current={currentPath === href ? "page" : undefined}
      >
        {label}
      </a>
    ))}
  </nav>
  <a class="header-contact" href="mailto:suhailsola@hotmail.com">Say hello <span aria-hidden="true">↗</span></a>
</header>
