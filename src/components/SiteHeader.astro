---
const links = [
  { href: "/", label: "Home" },
  { href: "/projects/", label: "Projects" },
  { href: "/showcase/", label: "Frontend lab" },
  { href: "/blog/", label: "Writing" },
];
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label="Suhail Solah home">suhail<span>.</span></a>
  <div class="header-tools">
    <nav aria-label="Main navigation">
      {links.map(({ href, label }) => (
        <a
          href={href}
          aria-current={currentPath === href ? "page" : undefined}
        >
          {label}
        </a>
      ))}
    </nav>
    <button class="theme-toggle" type="button" aria-label="Switch to dark mode" aria-pressed="false" title="Switch to dark mode">
      <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20.2 15.4A8.5 8.5 0 0 1 8.6 3.8 8.5 8.5 0 1 0 20.2 15.4Z" />
      </svg>
      <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
      </svg>
    </button>
  </div>
</header>

<script>
  const siteHeader = document.querySelector<HTMLElement>(".site-header");
  const themeToggle = document.querySelector<HTMLButtonElement>(".theme-toggle");

  const updateThemeToggle = () => {
    const isDark = document.documentElement.dataset.theme === "dark";
    const label = `Switch to ${isDark ? "light" : "dark"} mode`;
    themeToggle?.setAttribute("aria-label", label);
    themeToggle?.setAttribute("title", label);
    themeToggle?.setAttribute("aria-pressed", String(isDark));
  };

  updateThemeToggle();

  if (siteHeader && themeToggle) {
    const headerObserver = new IntersectionObserver(([entry]) => {
      themeToggle.classList.toggle("is-floating", !entry.isIntersecting);
    });

    headerObserver.observe(siteHeader);
  }

  themeToggle?.addEventListener("click", () => {
    const nextTheme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = nextTheme;
    localStorage.setItem("theme", nextTheme);
    updateThemeToggle();
  });
</script>
