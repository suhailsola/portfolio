---
import type { Project } from "@/data/projects";

interface Props {
  project: Project;
  index?: number;
}

const { project, index = 0 } = Astro.props;
---

<article
  class:list={["project-card", { "project-card-text": !project.image }]}
  style={`--card-index: ${index}`}
>
  {project.image && (
    <a
      class="project-image"
      href={project.href}
      target="_blank"
      rel="noreferrer"
    >
      <img src={project.image} alt={project.imageAlt ?? ""} loading="lazy" />
      <span class="image-arrow" aria-hidden="true">
        ↗
      </span>
    </a>
  )}
  <div class="project-meta">
    <span>{project.category}</span>
    <h3>
      <a href={project.href} target="_blank" rel="noreferrer">
        {project.title}
      </a>
    </h3>
    <p>{project.description}</p>
    <a
      class="project-source"
      href={project.href}
      target="_blank"
      rel="noreferrer"
    >
      <span class="project-source-label">View source on GitHub</span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>
</article>
