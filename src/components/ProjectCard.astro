---
import type { Project } from "@/data/projects";

interface Props {
  project: Project;
  index?: number;
}

const { project, index = 0 } = Astro.props;
---

<article class="project-card" style={`--card-index: ${index}`}>
  <a class="project-image" href={project.href} target="_blank" rel="noreferrer">
    <img src={project.image} alt={project.imageAlt} loading="lazy" />
    <span class="image-arrow" aria-hidden="true">↗</span>
  </a>
  <div class="project-meta">
    <span>{project.category}</span>
    <h3><a href={project.href} target="_blank" rel="noreferrer">{project.title}</a></h3>
    <p>{project.description}</p>
  </div>
</article>
