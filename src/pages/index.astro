---
import SiteLayout from "@/layouts/SiteLayout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { experience } from "@/data/experience";
import { projects } from "@/data/projects";

const featuredProjects = projects.slice(0, 2);
---

<SiteLayout
  title="Fullstack Developer"
  description="Suhail Solahuddin is a Fullstack Developer in Malaysia, building web applications, APIs, and product experiences."
>
  <section class="hero section-wrap">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="status-dot"></span> Fullstack developer · Malaysia
      </p>
      <h1>
        I build web products.
        <br />
        <span>Front to back.</span>
      </h1>
      <p class="hero-intro">
        I’m Muhammad Suhail, a Fullstack Developer turning product requirements
        into polished interfaces, dependable APIs, and practical applications.
      </p>
      <div class="hero-actions">
        <a class="button button-dark" href="/projects/">
          Explore my work <span aria-hidden="true">↗</span>
        </a>
        <a class="button button-secondary" href="mailto:suhailsola@hotmail.com">
          Get in touch
        </a>
      </div>
      <p class="hero-note">
        Experienced across frontend, backend, API integrations, and close
        collaboration with product and design teams.
      </p>
    </div>
    <div class="hero-art">
      <div class="hero-orbit orbit-one"></div>
      <div class="hero-orbit orbit-two"></div>
      <img src="/assets/suhail-no-bg.png" alt="Portrait of Muhammad Suhail" />
      <span class="art-caption">
        A little bit of code,
        <br />a lot of curiosity.
      </span>
    </div>
  </section>

  <section class="intro-band">
    <div class="section-wrap intro-grid">
      <p class="eyebrow">How I work</p>
      <div>
        <h2>
          Strong products start with <span>good collaboration.</span>
        </h2>
        <p>
          I work with product managers, designers, and engineers to understand
          user needs and deliver maintainable web applications—from interfaces
          and dashboards to APIs and integrations.
        </p>
      </div>
    </div>
  </section>

  <section class="section-wrap section-block">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Projects</p>
        <h2>
          Ideas made into <span>working software.</span>
        </h2>
      </div>
      <a class="text-link" href="/projects/">
        <span class="text-link-label">All projects</span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="project-grid">
      {featuredProjects.map((project, index) => (
        <ProjectCard project={project} index={index} />
      ))}
    </div>
  </section>

  <section class="experience-section">
    <div class="section-wrap">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Experience</p>
          <h2>
            Experience in software <span>and product validation.</span>
          </h2>
        </div>
        <a class="text-link" href="/career/">
          <span class="text-link-label">Full career history</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
      <ul class="experience-list">
        {experience.map(({ company, role, period }) => (
          <li class="experience-item">
            <div>
              <h3>{company}</h3>
              <p>{role}</p>
            </div>
            <time>{period}</time>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="lab-band">
    <div class="section-wrap lab-callout">
      <div class="lab-mark" aria-hidden="true">
        <span>Aa</span>
      </div>
      <div>
        <p class="eyebrow">Frontend playground</p>
        <h2>
          Exploring what makes
          <br />
          <span>interfaces feel right.</span>
        </h2>
      </div>
      <a class="button button-light" href="/showcase/">
        Explore the playground <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

  <section class="section-wrap contact-band">
    <p class="eyebrow">Have a product in mind?</p>
    <h2>
      Let’s build something <span>useful.</span>
    </h2>
    <a class="button button-dark" href="mailto:suhailsola@hotmail.com">
      Start a conversation <span aria-hidden="true">↗</span>
    </a>
  </section>
</SiteLayout>
