---
import SiteLayout from "@/layouts/SiteLayout.astro";

const colors = [
  { name: "Pine", value: "#203d32" },
  { name: "Moss", value: "#b5c5a1" },
  { name: "Clay", value: "#c96f4a" },
  { name: "Paper", value: "#f5f2e9" },
];
---

<SiteLayout
  title="Visual Style Study"
  description="A visual study of the colors, typography, and interface details used across this portfolio, with forest greens balanced by warm neutrals and subtle clay accents."
>
  <section class="page-hero section-wrap showcase-hero">
    <p class="eyebrow">Visual style study</p>
    <h1>
      A little forest
      <br />
      <span>in the interface.</span>
    </h1>
    <p class="page-lede">
      A visual study of the colors, typography, and interface details used
      across this portfolio. Forest greens set the tone, balanced with warm
      neutrals and subtle clay accents.
    </p>
  </section>
  <section class="section-wrap showcase-content">
    <div class="showcase-heading">
      <p class="eyebrow">Color study</p>
      <h2>
        A forest-inspired <span>palette.</span>
      </h2>
      <p>
        Pine anchors the palette, with moss, clay, and warm paper adding
        contrast and softness.
      </p>
      <p class="color-copy-status" role="status" aria-live="polite">
        Click a swatch to copy its hex code.
      </p>
    </div>
    <div class="swatch-grid">
      {colors.map((color) => (
        <button
          class="swatch"
          type="button"
          style={`--swatch: ${color.value}`}
          data-copy-color={color.value}
          aria-label={`Copy ${color.name} color ${color.value}`}
        >
          <div class="swatch-color"></div>
          <div>
            <strong>{color.name}</strong>
            <code>{color.value}</code>
          </div>
        </button>
      ))}
    </div>

    <div class="showcase-heading type-study">
      <p class="eyebrow">Type in context</p>
      <h2>
        Typography sets <span>the mood.</span>
      </h2>
      <p>
        Expressive serif headings give the page a softer feel, while clean
        sans-serif text keeps it comfortable to read.
      </p>
    </div>
    <div class="type-specimen">
      <span class="eyebrow">The quick brown fox</span>
      <p class="specimen-large">
        Ideas grow
        <br />
        when we make.
      </p>
      <p class="specimen-body">
        Serif headlines add a little warmth; sans-serif body text keeps longer
        copy easy to read.
      </p>
    </div>

    <div class="showcase-heading motion-study">
      <p class="eyebrow">Button styles</p>
      <h2>
        Clear feedback, <span>without the fuss.</span>
      </h2>
      <p>
        A filled primary style and an outlined secondary style keep actions
        distinct while fitting the same visual system.
      </p>
    </div>
    <div
      class="button-specimen"
      role="group"
      aria-label="Button style examples"
    >
      <button class="button button-dark" type="button">
        Primary style
      </button>
      <button class="button button-outline" type="button">
        Secondary style
      </button>
      <span class="focus-hint">Tab to preview the keyboard focus outline</span>
    </div>
  </section>
</SiteLayout>

<script>
  const copyStatus =
    document.querySelector<HTMLParagraphElement>(".color-copy-status");
  const colorButtons =
    document.querySelectorAll<HTMLButtonElement>("[data-copy-color]");

  if (!copyStatus) {
    throw new Error("Color copy status element was not found.");
  }

  for (const button of colorButtons) {
    button.addEventListener("click", async () => {
      const color = button.dataset.copyColor;
      if (!color) {
        throw new Error("Color swatch is missing its hex code.");
      }

      try {
        await navigator.clipboard.writeText(color);
        copyStatus.textContent = `${color} copied to clipboard.`;
      } catch {
        copyStatus.textContent = `Could not copy ${color}. You can select the hex code and copy it manually.`;
      }
    });
  }
</script>
