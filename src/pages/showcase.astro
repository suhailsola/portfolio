---
import SiteLayout from "@/layouts/SiteLayout.astro";

const colors = [
  { name: "Pine", value: "#203d32" },
  { name: "Moss", value: "#b5c5a1" },
  { name: "Clay", value: "#c96f4a" },
  { name: "Paper", value: "#f5f2e9" },
];
---

<SiteLayout
  title="Frontend Playground"
  description="A visual study by Muhammad Suhail Solah exploring the color, typography, and interaction details that shape a web interface."
>
  <section class="page-hero section-wrap showcase-hero">
    <p class="eyebrow">Interface experiments</p>
    <h1>
      The details matter.
      <br />
      <span>Here’s a closer look.</span>
    </h1>
    <p class="page-lede">
      A collection of visual studies in color, type, and interaction—the small
      decisions that make an interface feel clear and considered.
    </p>
  </section>
  <section class="section-wrap showcase-content">
    <div class="showcase-heading">
      <p class="eyebrow">Color study</p>
      <h2>
        A grounded, <span>versatile palette.</span>
      </h2>
      <p>
        Deep pine and warm paper set the foundation; moss and clay add contrast
        where it helps.
      </p>
    </div>
    <div class="swatch-grid">
      {colors.map((color) => (
        <div class="swatch" style={`--swatch: ${color.value}`}>
          <div class="swatch-color"></div>
          <div>
            <strong>{color.name}</strong>
            <code>{color.value}</code>
          </div>
        </div>
      ))}
    </div>

    <div class="showcase-heading type-study">
      <p class="eyebrow">Type in context</p>
      <h2>
        Typography sets <span>the tone.</span>
      </h2>
      <p>
        A display face brings character. Readable body text and generous spacing
        keep the page easy to follow.
      </p>
    </div>
    <div class="type-specimen">
      <span class="eyebrow">The quick brown fox</span>
      <p class="specimen-large">
        Ideas grow
        <br />
        when we make.
      </p>
      <p class="specimen-body">
        This study pairs expressive headings with straightforward body text,
        using scale and spacing to create a clear reading rhythm.
      </p>
    </div>

    <div class="showcase-heading motion-study">
      <p class="eyebrow">Interaction states</p>
      <h2>
        Small details, <span>clear feedback.</span>
      </h2>
      <p>
        Hover the links or use Tab to reach them. Their focus states should be
        easy to see and consistent with the rest of the page.
      </p>
    </div>
    <div class="button-specimen">
      <a class="button button-dark" href="/projects/">
        Primary link <span aria-hidden="true">↗</span>
      </a>
      <a class="button button-outline" href="/blog/">
        Secondary link <span aria-hidden="true">↗</span>
      </a>
      <span class="focus-hint">Try Tab ↹</span>
    </div>
  </section>
</SiteLayout>
