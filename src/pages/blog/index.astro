---
import { getCollection } from "astro:content";
import SiteLayout from "@/layouts/SiteLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<SiteLayout
  title="Blog"
  description="Articles and notes by Muhammad Suhail Solah on full-stack development, frontend engineering, and building for the web."
>
  <section class="page-hero section-wrap">
    <p class="eyebrow">Articles &amp; notes</p>
    <h1>
      Notes on
      <br />
      <span>building for the web.</span>
    </h1>
    <p class="page-lede">
      Practical notes on frontend work, interface details, and lessons from
      building software.
    </p>
  </section>
  <section class="section-wrap page-content">
    <div class="post-list">
      {posts.map((post) => (
        <article class="post-row">
          <div class="post-copy">
            <p class="eyebrow">
              {post.data.pubDate.toLocaleDateString("en", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </p>
            <h2>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h2>
            <p>{post.data.description}</p>
            <div class="tag-list">
              {post.data.tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
          </div>
          <a
            class="post-arrow"
            href={`/blog/${post.id}/`}
            aria-label={`Read ${post.data.title}`}
          >
            ↗
          </a>
        </article>
      ))}
    </div>
  </section>
</SiteLayout>
