---
import { getCollection } from "astro:content";
import SiteLayout from "@/layouts/SiteLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<SiteLayout
  title="Writing"
  description="Notes and articles by Muhammad Suhail Solahuddin on software development, architecture, data, and the decisions behind building useful products."
>
  <section class="page-hero section-wrap blog-hero">
    <p class="eyebrow">Writing &amp; ideas</p>
    <h1>
      Thinking through
      <br />
      <span>building software.</span>
    </h1>
    <p class="page-lede">
      Notes on software architecture, data, frontend and backend development,
      and the decisions behind building useful products.
    </p>
  </section>
  <section class="section-wrap page-content blog-listing">
    <div class="post-list">
      {posts.map((post) => (
        <article class="post-row">
          <div class="post-copy">
            <time class="eyebrow" datetime={post.data.pubDate.toISOString()}>
              {post.data.pubDate.toLocaleDateString("en", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })}
            </time>
            <h2>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h2>
            <p>{post.data.description}</p>
            <div class="tag-list">
              {post.data.tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
          </div>
          <a
            class="post-arrow"
            href={`/blog/${post.id}/`}
            aria-label={`Read ${post.data.title}`}
          >
            ↗
          </a>
        </article>
      ))}
    </div>
  </section>
</SiteLayout>
