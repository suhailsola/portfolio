---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<SiteLayout
  title="Writing"
  description="Notes on learning software development, frontend craft, and the process of making things."
>
  <section class="page-hero section-wrap">
    <p class="eyebrow">Writing</p>
    <h1>Notes from<br /><span>the learning curve.</span></h1>
    <p class="page-lede">Thoughts, lessons, and small discoveries from making my way into software development.</p>
  </section>
  <section class="section-wrap page-content">
    <div class="post-list">
      {posts.map((post) => (
        <article class="post-row">
          <div class="post-copy">
            <p class="eyebrow">{post.data.pubDate.toLocaleDateString("en", { year: "numeric", month: "long", day: "numeric" })}</p>
            <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
            <p>{post.data.description}</p>
            <div class="tag-list">{post.data.tags.map((tag) => <span>{tag}</span>)}</div>
          </div>
          <a class="post-arrow" href={`/blog/${post.id}/`} aria-label={`Read ${post.data.title}`}>↗</a>
        </article>
      ))}
    </div>
  </section>
</SiteLayout>
