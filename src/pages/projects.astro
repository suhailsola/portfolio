---
import SiteLayout from "@/layouts/SiteLayout.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { projects } from "@/data/projects";
---

<SiteLayout
  title="Projects"
  description="Explore web applications and software projects by Muhammad Suhail Solah."
>
  <section class="page-hero projects-hero section-wrap">
    <p class="eyebrow">Projects</p>
    <h1>
      Ideas made into
      <br />
      <span>working software.</span>
    </h1>
    <p class="page-lede">
      A selection of projects exploring full-stack development, useful
      interfaces, and thoughtful product experiences.
    </p>
  </section>
  <section class="section-wrap section-block">
    <div class="project-grid">
      {projects.map((project, index) => (
        <ProjectCard project={project} index={index} />
      ))}
    </div>
  </section>
</SiteLayout>
